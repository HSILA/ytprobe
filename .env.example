# YouTube Data API v3 key (required for search endpoint)
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_api_key_here

# SoundBridge transcription service URL (optional, for fallback transcription)
# Only needed if you're running SoundBridge service locally
# Default: http://localhost:8742
SOUNDBRIDGE_URL=http://localhost:8742

# Server configuration
HOST=0.0.0.0
PORT=8743
